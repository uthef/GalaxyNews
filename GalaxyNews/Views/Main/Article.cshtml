@model ArticleModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Article.Title;
    ViewData["Description"] = Model.Article.Announce;
}

@section head 
{
    <link rel="stylesheet" href="~/styles/article.css">
}

<div class="separator"></div>

<div id="main-content">
    <div class="breadcrumbs">
        <a href="/">Главная</a>
        <span>/</span>
        <span>@Model.Article.Title</span>
    </div>
    <h1>@Model.Article.Title</h1>
    <div class="date top-space">@Formatter.GetDate(Model.Article.Date)</div>
    <div class="article-wrapper">
        <div class="text">
            <article>
                <h2 class="announce">
                    <span>@Model.Article.Announce</span>
                </h2>
                @foreach (var paragraphText in Model.Article.Content.Split("\n"))
                {
                    @if (paragraphText.Length == 0)
                        continue;

                    <p>@paragraphText</p>
                }
            </article>
            <div class="button-wrapper">
                <a class="button" href="@Formatter.GetPageLink(Model.FromPage)">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span>Назад к новостям</span>
                </a>
            </div>
        </div>
        <img src="@Model.AbsoluteImagePath" alt="Сгенерированное изображение, дополняющее содержимое статьи">
    </div>
</div>